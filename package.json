{
  "name": "barista-game",
  "version": "0.1.0",
  "description": "직업 ε바리스타3 - 발달장애 학생을 위한 바닷가 마을 카페 이야기 게임. 엔진은 직업 마1스톤 v2에서 가져옴",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node tools/serve.mjs 5175",
    "validate": "node tools/validate-scenarios.mjs",
    "export": "node tools/export-script.mjs",
    "requests": "node tools/export-requests.mjs",
    "assets": "node tools/scan-assets.mjs",
    "audio": "node tools/import-audio.mjs && node tools/scan-assets.mjs",
    "images": "python tools/import-images.py && node tools/scan-assets.mjs",
    "objects": "python tools/import-objects.py && node tools/scan-assets.mjs",
    "movies": "node tools/import-movies.mjs && node tools/scan-assets.mjs",
    "credits": "node tools/export-credits.mjs",
    "build:web": "node tools/build-web.mjs",
    "lines": "node tools/export-lines.mjs",
    "voices": "node tools/export-lines.mjs && node tools/run-voices.mjs",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "barista",
    "special-education",
    "visual-novel",
    "electron",
    "accessibility"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.barista-game.app",
    "productName": "직업 ε바리스타3",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "css/**",
      "js/**",
      "assets/**",
      "!assets/**/*.md",
      "!assets/*_sheet.jpg",
      "!assets/_src/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
